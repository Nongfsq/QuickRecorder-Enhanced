          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta H.265 MP4, High 2x, 15 FPS, VFR adattivo, bitrate video automatico, audio mono AAC 64 Kbps, riduzione del rumore del microfono e archivio AV1 automatico dopo la registrazione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 H.265 MP4、高 2x、15 FPS、自适应 VFR、自动视频码率、AAC 64 Kbps 单声道、麦克风降噪，并开启录制后自动 AV1 压缩。"
