    "CRF 56 is the current safe lecture archive default. Lower values are larger and higher quality.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CRF 56 is the current safe lecture archive default. Lower values are larger and higher quality."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CRF 56 è l'attuale impostazione predefinita per l'archivio delle lezioni sicuro. I valori più bassi corrispondono a valori più grandi e di qualità superiore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CRF 56 是当前课程归档的安全默认值。数值越低文件越大、画质越高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CRF 56 是目前課程封存的安全預設值。數值越低檔案越大、畫質越高。"
          }
        }
      }
