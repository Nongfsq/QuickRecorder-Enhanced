            "state": "translated",
            "value": "La registrazione originale non esiste più. Questa attività non può essere riavviata."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始录像已不存在，无法重新开始此任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始錄影已不存在，無法重新開始此工作。"
          }
        }
      }
    },
    "The output path is a file instead of a folder!": {
      "localizations": {
