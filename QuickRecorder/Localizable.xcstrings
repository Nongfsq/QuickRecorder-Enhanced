{
  "sourceLanguage": "en",
  "strings": {
    "\nthis might be due to the window closing or the user stopping from the sonoma ui": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nthis might be due to the window closing or the user stopping from the sonoma ui"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ciò potrebbe essere dovuto alla chiusura della finestra o all'interruzione dell'utente dall'interfaccia utente di Sonoma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n这可能是有由于用户关闭了正在录制中的窗口, 或使用窗口上的附加按钮停止了录制."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n这可能是有由于用户关闭了正在录制中的窗口, 或使用窗口上的附加按钮停止了录制."
          }
        }
      }
    },
