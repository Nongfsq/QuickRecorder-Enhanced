    "You are using macOS 12.7.4\nOutput files will be randomly corrupted on this version of macOS!\n\nPlease upgrade to 12.7.5 to solve it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are using macOS 12.7.4\nOutput files will be randomly corrupted on this version of macOS!\n\nPlease upgrade to 12.7.5 to solve it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai utilizzando macOS 12.7.4\nI file di output saranno danneggiati casualmente su questa versione di macOS!\n\nAggiorna a 12.7.5 per risolvere il problema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到当前系统版本为 macOS 12.7.4\nQuickRecorder 在当前系统版本中会\n随机出现录像文件保存失败的情况!\n\n请升级至 macOS 12.7.5 以解决此问题."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢測到當前系統版本為 macOS 12.7.4\nQuickRecorder 在當前系統版本中會\n隨機出現錄影檔案儲存失敗的情況!\n\n請升級至 macOS 12.7.5 以解決此問題."
          }
        }
      }
    },
