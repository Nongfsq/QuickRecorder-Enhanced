    "After the HEVC master is saved, QuickRecorder will create a verified AV1 archive in the background.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the HEVC master is saved, QuickRecorder will create a verified AV1 archive in the background."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver salvato il master HEVC, QuickRecorder creerà un archivio AV1 verificato in background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC 母版保存后，QuickRecorder 会在后台创建经过验证的 AV1 归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC 母版儲存後，QuickRecorder 會在背景建立經過驗證的 AV1 封存。"
          }
        }
      }
    },
