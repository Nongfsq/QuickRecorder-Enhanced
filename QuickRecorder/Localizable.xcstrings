    "Auto keeps QuickRecorder's original quality-based bitrate. Fixed low bitrates are useful for lecture slides and mostly static screens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto keeps QuickRecorder's original quality-based bitrate. Fixed low bitrates are useful for lecture slides and mostly static screens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità automatica mantiene il bitrate originale basato sulla qualità di QuickRecorder. I bitrate fissi bassi sono utili per diapositive e schermate prevalentemente statiche."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动模式会保留 QuickRecorder 原有的基于质量的码率。较低的固定码率适合演示文稿和大部分静止的画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動模式會保留 QuickRecorder 原有的品質導向位元率。較低的固定位元率適合簡報和大部分靜止的畫面。"
          }
        }
      }
    },
