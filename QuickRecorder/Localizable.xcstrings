            "value": "此應用程式沒有可錄製的視窗!"
          }
        }
      }
    },
    "This removes recovery records, logs, and task-owned temporary files. Original recordings and completed archives are not deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes recovery records, logs, and task-owned temporary files. Original recordings and completed archives are not deleted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò rimuove i record di ripristino, i registri e i file temporanei di proprietà delle attività. Le registrazioni originali e gli archivi completati non vengono cancellati."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除恢复记录、日志和任务自己的临时文件，不会删除原始录像或已经完成的正式归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除恢復記錄、日誌和工作自己的暫存檔案，不會刪除原始錄影或已完成的正式封存。"
          }
        }
      }
    },
