    "Reduces steady background noise on the microphone using the tested 80% RNNoise and 20% original mix. System audio is not changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduces steady background noise on the microphone using the tested 80% RNNoise and 20% original mix. System audio is not changed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduce il rumore di fondo costante del microfono usando una miscela testata composta dall'80% di RNNoise e dal 20% dell'audio originale. L'audio di sistema non viene modificato."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已测试的 80% RNNoise 与 20% 原声混合，降低麦克风中的持续背景噪声。系统声音不会被处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已測試的 80% RNNoise 與 20% 原聲混合，降低麥克風中的持續背景噪音。系統聲音不會被處理。"
          }
        }
      }
