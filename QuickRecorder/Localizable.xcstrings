    "These apps will be excluded when recording \"Screen\" or \"Screen Area\"\nBut if the app is launched after the recording starts, it cannot be excluded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These apps will be excluded when recording \"Screen\" or \"Screen Area\"\nBut if the app is launched after the recording starts, it cannot be excluded."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste app saranno escluse quando si registra \"Schermo\" o \"Area dello schermo\"\n* Ma se l'app viene avviata dopo l'inizio della registrazione, non può essere esclusa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在录制 \"全屏画面\" 或 \"屏幕区域\" 的时候将不会录制这些 App 的画面\n但如果列表中的 App 在录屏开始后才被启动, 则无法被排除在录制画面之外."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在錄製 \"整個螢幕\" 或 \"螢幕區域\" 的時候將不會錄製這些 App 的畫面\n但如果列表中的 App 在錄影開始後才被啟動, 則無法被排除在錄製畫面之外."
          }
        }
      }
    },
    "This app exists in multiple screens, please select it manually!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app exists in multiple screens, please select it manually!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app esiste in più schermate, selezionala manualmente!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用程序同时存在于多个屏幕中, 请手动选择!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式同時存在於多個螢幕中, 請手動選擇!"
          }
        }
      }
    },
