    "Skips tiny-change frames while preserving full-rate frames during active motion. Best for lecture slides, notes, and mostly static screens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skips tiny-change frames while preserving full-rate frames during active motion. Best for lecture slides, notes, and mostly static screens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora i fotogrammi con variazioni minime, mantenendo la frequenza completa durante il movimento. Ideale per diapositive, appunti e schermate prevalentemente statiche."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在活动画面中保留完整帧率，同时跳过变化极小的帧。最适合演示文稿、笔记和大部分静止的画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在動態畫面中保留完整影格率，同時略過變化極小的影格。最適合簡報、筆記和大部分靜止的畫面。"
          }
        }
      }
    },
