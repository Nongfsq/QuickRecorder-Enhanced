    "VideoToolbox H.264 hardware encoder doesn't support the current resolution.\nContinue with a software encoder will significantly increase the CPU usage.\n\nWould you like to use H.265 instead?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VideoToolbox H.264 hardware encoder doesn't support the current resolution.\nContinue with a software encoder will significantly increase the CPU usage.\n\nWould you like to use H.265 instead?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codificatore hardware H.264 di VideoToolbox non supporta la risoluzione corrente.\nContinuare con un codificatore software aumenterà in modo significativo l'utilizzo della CPU.\n\nDesideri invece utilizzare H.265?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统 H.264 硬件编码器不支持当前分辨率\n继续使用 H.264 编码录制将大量占用CPU\n\n是否改为使用 H.265 编码进行录制?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建 H.264 硬體編碼器不支援當前解析度\n繼續使用 H.264 編碼錄製將大量佔用CPU\n\n是否改為使用 H.265 編碼進行錄製?"
          }
        }
      }
    },
    "Waiting on update…": {
      "localizations": {
        "en": {
          "stringUnit": {
