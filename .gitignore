# Signing credentials and local release configuration
*.cer
*.p12
*.pem
*.key
*.mobileprovision
.env
.env.*
Config/Local.xcconfig

# Recordings and generated media must never be committed
*.m4a
*.qma
*.mp4
*.mov
*.m4v
*.wav

# Generated FFmpeg runtime payload. Build it locally with Tools/Archive.
QuickRecorder/Resources/FFmpegRuntime/bin/*
QuickRecorder/Resources/FFmpegRuntime/lib/*
!QuickRecorder/Resources/FFmpegRuntime/bin/.gitkeep
!QuickRecorder/Resources/FFmpegRuntime/lib/.gitkeep
